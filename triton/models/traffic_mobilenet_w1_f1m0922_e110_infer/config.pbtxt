name: "traffic_mobilenet_w1_f1m0922_e110_infer"
backend: "onnxruntime"
max_batch_size: 8

default_model_filename: "mobilenetv1_w1.0_f1m_0.922_e110.onnx"

input [
    {
        name: "input"
        data_type: TYPE_FP32
        format: FORMAT_NCHW
        dims: [ 1, 256, 173 ]
    }
]

output [
    {
        name: "category_output"
        data_type: TYPE_FP32
        dims: [ 5 ]
    },
    {
        name: "target_output"
        data_type: TYPE_FP32
        dims: [ 7 ]
    }
]