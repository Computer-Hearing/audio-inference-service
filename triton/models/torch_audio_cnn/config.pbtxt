name: "torch_audio_cnn"
platform: "onnxruntime_onnx"
max_batch_size: 1

input = [
    {
        name:"input"
        data_type: TYPE_FP32
        format: FORMAT_NCHW
        dims: [ 1, 1, 256, 173 ]
    }
]

output = [
    {
        name: "category_output"
        data_type: TYPE_FP32
        dims: [ 1, 5 ]
    },
    {
        name: "target_output"
        data_type: TYPE_FP32
        dims: [ 1, 7 ]
    }
]