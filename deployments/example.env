# Redis: очередь задач и хранилище состояния
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Сколько живёт задача (и результат) после последнего обновления
TASK_TTL=1h

# Redis Streams: stream, consumer group и параметры восстановления
TASK_STREAM=tasks
TASK_GROUP=inference
TASK_ACK_WAIT=10m
TASK_MAX_DELIVERIES=3
